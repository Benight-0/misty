[Unit]
Description=Misty isolated VM browser worker
After=misty-laptop-tools.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=misty-bot
Group=misty-bot
WorkingDirectory=/opt/misty-bot
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/misty-bot/ms-playwright
ExecStart=/opt/misty-bot/bin/node --disable-warning=ExperimentalWarning /opt/misty-bot/scripts/misty-browser-worker.mjs
LoadCredential=vm-browser-token:/etc/misty-bot/vm-browser-token
Restart=on-failure
RestartSec=8
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/misty-bot
MemoryMax=512M
TasksMax=96

[Install]
WantedBy=multi-user.target
