{
  "manifest_version": 3,
  "name": "Misty private activity",
  "version": "1.0.0",
  "description": "Send only Chrome tab/window metadata to your private laptop activity collector. No page contents.",
  "key": "",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "minimum_chrome_version": "120"
}
