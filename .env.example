# Copy to .env and set values for your own installation. Never commit .env.
POSTGRES_PASSWORD=

# Verified owner identities. Empty values grant no connected-account authority.
MISTY_OWNER_DISCORD_ID=
MISTY_OWNER_WHATSAPP_PHONE=
MISTY_OWNER_WHATSAPP_LID=
MISTY_OWNER_MATRIX_ID=@owner:localhost

# Optional externally hosted Archival instance. Leave blank for loopback-only use.
ARCHIVAL_PUBLIC_ORIGIN=
ARCHIVAL_ACCESS_EMAIL=
CF_ACCESS_ISSUER=
CF_ACCESS_AUD=

# Optional paths for separately provisioned credentials; never paste tokens here.
MISTY_ARCHIVE_TOKEN_FILE=
ARCHIVAL_MESSAGE_TOKEN_FILE=