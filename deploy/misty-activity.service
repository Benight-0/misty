[Unit]
Description=Misty private laptop activity ingestion
After=network.target misty-bot.service

[Service]
Type=simple
User=misty-bot
Group=misty-bot
WorkingDirectory=/opt/misty-bot
ExecStart=/opt/misty-bot/bin/node --disable-warning=ExperimentalWarning /opt/misty-bot/scripts/misty-activity-ingest.mjs
LoadCredential=relay-token:/var/lib/misty-bot/relay-token
LoadCredential=prominence-token:/etc/misty-bot/prominence-token
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/misty-bot
MemoryMax=96M
CPUQuota=15%
TasksMax=32

[Install]
WantedBy=multi-user.target
